# Dependências e saídas de build (pesadas e geradas por "npm install" / "npm run build")
node_modules/
dist/

# ---------------------------------------------------------------- DADOS PESSOAIS
# NUNCA publique estes arquivos. O digideck.json é o cofre do DesDeck: ele guarda
# as suas contas, telas e proxies. É criptografado, mas a chave vem da DPAPI do
# Windows (ou da sua senha), então publicá-lo expõe os seus dados.
digideck.json
digideck.ilegivel-*.json
*.backup-*.json

# Scripts de usuário podem conter ids de conta, proxies ou outros dados seus.
scripts/

# Saídas de teste e logs
*.log
*.out.txt
# Relatorios dos testes headless (o stdout do Electron no Windows se perde, entao
# eles escrevem em arquivo). Podem conter nick e saldo da conta testada.
*-report.txt
# Idem: saída do test-lab-campos, traz o nick da conta.
lab-campos.txt
# Idem: saídas da descoberta do Passe, trazem nick, nível e progresso da conta.
passe-campos.txt
passe-dump.txt
passe-estado.txt
passe-grep.txt
passe-vivo.txt
# Idem: saída do grep do Labirinto no JS do jogo (só código público, mas é
# arquivo gerado, não fonte).
lab-grep.txt
# Idem: saídas da descoberta do Mercado e dos testes do Sniper, trazem nick,
# saldo e as compras feitas na conta real.
mercado-campos.txt
mercado-filtros.txt
mercado-grep.txt
sniper-fila.txt
sniper-headless.txt
sniper-log.txt
itens-probe.txt
form-probe.txt
sniper-real.txt
sniper-tool.txt
sniper-vivo.txt
# Idem para o Auto Seller. O seller-vivo.txt em especial traz o id da partição,
# o nick, o saldo e a mochila da conta real onde a sonda rodou.
seller-form.txt
seller-headless.txt
seller-tool.txt
seller-vivo.txt
# A saída do grep do Painel 2 no JS do jogo: arquivo gerado, não fonte.
painel2-grep.txt
